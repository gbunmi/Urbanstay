rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.userId == request.auth.uid &&
               data.email is string && data.email.size() <= 100 &&
               data.fullName is string && data.fullName.size() <= 100 &&
               data.role in ['TENANT', 'LANDLORD', 'AGENT', 'ADMIN'] &&
               data.keys().hasAll(['userId', 'email', 'fullName', 'role']) &&
               data.keys().size() >= 4;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'bio', 'avatarUrl'])
      ) || isAdmin();
    }

    // Property Rules
    match /properties/{propertyId} {
      function isValidProperty(data) {
        return data.propertyId is string &&
               data.landlordId == request.auth.uid &&
               data.title is string && data.title.size() <= 200 &&
               data.price is number && data.price > 0 &&
               data.status in ['AVAILABLE', 'RENTED', 'UNDER_REVIEW'];
      }

      allow read: if true; // Public listings
      allow create: if isSignedIn() && isEmailVerified() && isValidProperty(incoming());
      allow update: if isSignedIn() && (
        // Landlord update
        (existing().landlordId == request.auth.uid && isValidProperty(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'amenities', 'images', 'status', 'updatedAt'])
        )) ||
        // Admin update
        isAdmin() ||
        // Global count/rating updates via system (simplified for now)
        (incoming().diff(existing()).affectedKeys().hasOnly(['rating'])) 
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().landlordId == request.auth.uid);
    }

    // Booking Rules
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.tenantId == request.auth.uid &&
               data.propertyId is string &&
               data.totalPrice is number &&
               data.status in ['PENDING', 'CONFIRMED', 'CANCELLED', 'COMPLETED'];
      }

      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || 
                     get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.landlordId == request.auth.uid);
      allow create: if isSignedIn() && isEmailVerified() && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        (resource.data.tenantId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.landlordId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      ) || isAdmin();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid == incoming().senderId &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Wishlist Rules
    match /users/{userId}/wishlist/{propertyId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
  }
}
